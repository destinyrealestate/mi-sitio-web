# === Charset UTF-8 (defensa extra; el fix principal es el <meta> en el HTML) ===
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
  AddType "text/html; charset=UTF-8" .html .htm
</IfModule>

# ============================================================
# Cabeceras de seguridad (agregadas 2026-08-08)
# ============================================================
# Hasta hoy el sitio no mandaba ninguna: lo único que respondía era el
# "content-security-policy: upgrade-insecure-requests" que pone Hostinger
# por su cuenta.
#
# La que más pesa aquí es X-Frame-Options. Sin ella, destiny.mx se puede
# montar dentro de un iframe ajeno y hacer clickjacking encima de los
# formularios de captura: el visitante cree que hace clic en otra cosa y
# en realidad está enviando sus datos. Con formularios de lead en casi
# todas las páginas, ese es el riesgo concreto, no uno teórico.
#
# Lo que NO está aquí a propósito: una CSP completa. Con GTM, GA4, el
# Pixel de Meta y ContentSquare cargando por script inyectado, una CSP mal
# calibrada rompe la medición entera y lo hace en silencio — las etiquetas
# dejan de disparar sin que nada se vea roto en la página. Ese trabajo
# empieza en Content-Security-Policy-Report-Only, se observa una o dos
# semanas y recién entonces se aplica. Es un proyecto aparte.
<IfModule mod_headers.c>
  # No adivinar el tipo de archivo por su contenido.
  Header always set X-Content-Type-Options "nosniff"

  # Nadie mete este sitio en un iframe ajeno.
  Header always set X-Frame-Options "SAMEORIGIN"

  # Al salir a otro dominio se manda el origen, no la URL completa con sus
  # parámetros. Protege los ?p= y ?utm_ de acabar en registros de terceros.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # El sitio no usa cámara, micrófono ni ubicación: se declaran cerrados.
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # HSTS a 180 días. Sin preload ni includeSubDomains a propósito: el
  # subdominio del blog vive en otro stack y preload es de una sola vía,
  # no se puede deshacer rápido si algo sale mal.
  Header always set Strict-Transport-Security "max-age=15552000" env=HTTPS
</IfModule>

# ============================================================
# Archivos de trabajo que NO se sirven
# ============================================================
# El deploy es un checkout del repo entero: todo lo que está en Git queda
# accesible por URL. Hasta el 2026-08-03, destiny.mx/MEDICION.md respondía
# 200 con los IDs de GA4, Ads, Pixel y GTM, la ruta interna del servidor y
# la lista de lo que falta configurar. No hay credenciales en ninguno, pero
# es el mapa de la operación servido a quien lo pida.
#
# Nada del sitio enlaza a estos archivos: verificado antes de bloquearlos.
# Si algún día se publica una guía en .md pensada para leerse, sacarla de
# aquí en vez de quitar la regla.
<FilesMatch "\.(md|py|zip)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# ============================================================
# Destiny Real Estate — Apache rewrites (sitio estático Hostinger)
# Migración blog: WP movido a blog.destiny.mx (side-by-side)
# Las URLs viejas redirigen al subdominio del blog.
# ============================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Articulo.html?post={slug}  ó  ?art={slug}  →  https://blog.destiny.mx/blog/tips-invertir/{slug}/
  RewriteCond %{QUERY_STRING} (^|&)(post|art)=([a-z0-9\-]+) [NC]
  RewriteRule ^Articulo\.html$ https://blog.destiny.mx/blog/tips-invertir/%3/? [R=301,L,NE]

  # Articulo.html sin slug  →  blog.destiny.mx
  RewriteRule ^Articulo\.html$ https://blog.destiny.mx/ [R=301,L,NC]

  # Blog.html  →  blog.destiny.mx
  RewriteRule ^Blog\.html$ https://blog.destiny.mx/ [R=301,L,NC]

  # ----------------------------------------------------------
  # Rutas cortas de campaña. Se dictan a cámara y van en las
  # biografías: no pueden cambiar nunca.
  #   destiny.mx/agenda  destiny.mx/club  destiny.mx/radar  destiny.mx/scorecard
  # Reescritura interna: la URL visible NO cambia (responde 200).
  # ----------------------------------------------------------
  RewriteRule ^(agenda|club|radar|scorecard)$   $1.html   [L]
  # Con diagonal final → un solo salto a la versión sin diagonal.
  RewriteRule ^(agenda|club|radar|scorecard)/$  /$1       [R=301,L]

  # ----------------------------------------------------------
  # Landing pages de Google Ads (fase 1) y sus páginas de gracias.
  # Las URLs de destino de los anuncios tienen que ser limpias, en
  # minúsculas y sin parámetros: así las escribe la campaña y así las
  # califica Google. Reescritura interna → responden 200.
  #
  # /guia rescata además una fuga vieja: /Guia.html estaba enlazada
  # desde el menú del blog y desde campañas, y respondía 404.
  # ----------------------------------------------------------
  RewriteRule ^(preconstruccion-miami|invertir-en-dolares)$   $1.html   [L]
  RewriteRule ^(preconstruccion-miami|invertir-en-dolares)/$  /$1       [R=301,L]

  # ----------------------------------------------------------
  # Landings de proyecto (A/B de estructura). Mismo contenido, el
  # formulario en distinta posición: son las URLs de destino de los
  # anuncios de Meta y Google y también se mandan por WhatsApp, así
  # que tienen que ser limpias. Van noindex y fuera del sitemap.
  # ----------------------------------------------------------
  RewriteRule ^(bentley-lp1|bentley-lp2|bentley-lp3)$   $1.html   [L]
  RewriteRule ^(bentley-lp1|bentley-lp2|bentley-lp3)/$  /$1       [R=301,L]

  RewriteRule ^(gracias-preconstruccion|gracias-dolares|gracias-guia)$   $1.html   [L]
  RewriteRule ^(gracias-preconstruccion|gracias-dolares|gracias-guia)/$  /$1       [R=301,L]

  # Las páginas de gracias anteriores a las landings nacieron sin ruta
  # limpia: respondían 404 y solo servía la versión .html. Cada una dispara
  # una conversión en GTM, así que configurar la redirección en Zoho con la
  # ruta limpia la perdía sin hacer ruido — gracias-sesion es la más cara
  # (agenda_solicitada, 2000 MXN). Añadidas el 2026-08-05. Las .html siguen
  # vivas: hay redirecciones de Zoho y enlaces viejos apuntando ahí.
  RewriteRule ^(gracias-sesion|gracias-club|gracias-scorecard|gracias-newsletter)$   $1.html   [L]
  RewriteRule ^(gracias-sesion|gracias-club|gracias-scorecard|gracias-newsletter)/$  /$1       [R=301,L]

  # La guía: /guia responde 200 y /Guia.html sigue vivo para los enlaces
  # viejos, que llegan con esa mayúscula exacta.
  RewriteRule ^guia/?$  /Guia.html  [L]

  # ----------------------------------------------------------
  # Rescate de las rutas de la era WordPress.
  # Estaban en el sitemap y en las canónicas, y hoy responden 404.
  # Un solo salto: origen → destino final.
  # ----------------------------------------------------------
  RewriteRule ^marca/?$      /Marca.html      [R=301,L]
  RewriteRule ^inversion/?$  /Inversion.html  [R=301,L]

  # /propiedad/?proj={slug}  →  /Propiedad.html?p={slug}
  RewriteCond %{QUERY_STRING} (?:^|&)proj=([a-z0-9\-]+)
  RewriteRule ^propiedad/?$  /Propiedad.html?p=%1  [R=301,L]
  RewriteRule ^propiedad/?$  /#mapa  [R=301,L,NE]

  # /zona/?z={slug}  →  /Zona.html?z={slug}
  RewriteCond %{QUERY_STRING} (?:^|&)z=([a-z0-9\-]+)
  RewriteRule ^zona/?$  /Zona.html?z=%1  [R=301,L]
  RewriteRule ^zona/?$  /#zonas  [R=301,L,NE]
</IfModule>

# ============================================================
# Caché de estáticos. El HTML no se cachea de forma agresiva
# para que un redespliegue se vea de inmediato.
# ============================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                 "access plus 1 year"
  ExpiresByType application/javascript   "access plus 1 year"
  ExpiresByType text/javascript          "access plus 1 year"
  ExpiresByType image/jpeg               "access plus 6 months"
  ExpiresByType image/png                "access plus 6 months"
  ExpiresByType image/webp               "access plus 6 months"
  ExpiresByType image/avif               "access plus 6 months"
  ExpiresByType image/svg+xml            "access plus 6 months"
  ExpiresByType video/mp4                "access plus 6 months"
  ExpiresByType application/pdf          "access plus 1 month"
  ExpiresByType text/html                "access plus 0 seconds"
  ExpiresByType application/xml          "access plus 0 seconds"
</IfModule>
