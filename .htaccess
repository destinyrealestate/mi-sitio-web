# === Charset UTF-8 (defensa extra; el fix principal es el <meta> en el HTML) ===
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
  AddType "text/html; charset=UTF-8" .html .htm
</IfModule>

# ============================================================
# Archivos de trabajo que NO se sirven
# ============================================================
# El deploy es un checkout del repo entero: todo lo que está en Git queda
# accesible por URL. Hasta el 2026-08-03, destiny.mx/MEDICION.md respondía
# 200 con los IDs de GA4, Ads, Pixel y GTM, la ruta interna del servidor y
# la lista de lo que falta configurar. No hay credenciales en ninguno, pero
# es el mapa de la operación servido a quien lo pida.
#
# Nada del sitio enlaza a estos archivos: verificado antes de bloquearlos.
# Si algún día se publica una guía en .md pensada para leerse, sacarla de
# aquí en vez de quitar la regla.
<FilesMatch "\.(md|py|zip)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# ============================================================
# Destiny Real Estate — Apache rewrites (sitio estático Hostinger)
# Migración blog: WP movido a blog.destiny.mx (side-by-side)
# Las URLs viejas redirigen al subdominio del blog.
# ============================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Articulo.html?post={slug}  ó  ?art={slug}  →  https://blog.destiny.mx/blog/tips-invertir/{slug}/
  RewriteCond %{QUERY_STRING} (^|&)(post|art)=([a-z0-9\-]+) [NC]
  RewriteRule ^Articulo\.html$ https://blog.destiny.mx/blog/tips-invertir/%3/? [R=301,L,NE]

  # Articulo.html sin slug  →  blog.destiny.mx
  RewriteRule ^Articulo\.html$ https://blog.destiny.mx/ [R=301,L,NC]

  # Blog.html  →  blog.destiny.mx
  RewriteRule ^Blog\.html$ https://blog.destiny.mx/ [R=301,L,NC]

  # ----------------------------------------------------------
  # Rutas cortas de campaña. Se dictan a cámara y van en las
  # biografías: no pueden cambiar nunca.
  #   destiny.mx/agenda  destiny.mx/club  destiny.mx/radar  destiny.mx/scorecard
  # Reescritura interna: la URL visible NO cambia (responde 200).
  # ----------------------------------------------------------
  RewriteRule ^(agenda|club|radar|scorecard)$   $1.html   [L]
  # Con diagonal final → un solo salto a la versión sin diagonal.
  RewriteRule ^(agenda|club|radar|scorecard)/$  /$1       [R=301,L]

  # ----------------------------------------------------------
  # Rescate de las rutas de la era WordPress.
  # Estaban en el sitemap y en las canónicas, y hoy responden 404.
  # Un solo salto: origen → destino final.
  # ----------------------------------------------------------
  RewriteRule ^marca/?$      /Marca.html      [R=301,L]
  RewriteRule ^inversion/?$  /Inversion.html  [R=301,L]

  # /propiedad/?proj={slug}  →  /Propiedad.html?p={slug}
  RewriteCond %{QUERY_STRING} (?:^|&)proj=([a-z0-9\-]+)
  RewriteRule ^propiedad/?$  /Propiedad.html?p=%1  [R=301,L]
  RewriteRule ^propiedad/?$  /#mapa  [R=301,L,NE]

  # /zona/?z={slug}  →  /Zona.html?z={slug}
  RewriteCond %{QUERY_STRING} (?:^|&)z=([a-z0-9\-]+)
  RewriteRule ^zona/?$  /Zona.html?z=%1  [R=301,L]
  RewriteRule ^zona/?$  /#zonas  [R=301,L,NE]
</IfModule>

# ============================================================
# Caché de estáticos. El HTML no se cachea de forma agresiva
# para que un redespliegue se vea de inmediato.
# ============================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                 "access plus 1 year"
  ExpiresByType application/javascript   "access plus 1 year"
  ExpiresByType text/javascript          "access plus 1 year"
  ExpiresByType image/jpeg               "access plus 6 months"
  ExpiresByType image/png                "access plus 6 months"
  ExpiresByType image/webp               "access plus 6 months"
  ExpiresByType image/avif               "access plus 6 months"
  ExpiresByType image/svg+xml            "access plus 6 months"
  ExpiresByType video/mp4                "access plus 6 months"
  ExpiresByType application/pdf          "access plus 1 month"
  ExpiresByType text/html                "access plus 0 seconds"
  ExpiresByType application/xml          "access plus 0 seconds"
</IfModule>
